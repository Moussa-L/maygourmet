    <div class="row">
        <% resultatEquipe.forEach((result) =>{ %>
            <div class="container">
                <div class="card">
                    <h2><b><%= result.nom %> <%= result.prenom %><b></h2>
                    <p><%= result.poste %></p>
                    <button type="submit" onclick="supprimerMembre('<%= result.id %>')">Supprimer</button>

                    <!-- <input type="button" value="supprimer" onclick="supprimerMembre('<%= result.id %>')"> -->
                    <img src="/images/Gente blanca 3d.jpg" alt="Chef de projet">

                </div>

                

            </div>
        <% }); %>

    </div>


<div class="row">
    <!-- Trigger/Open The Modal -->
    <button id="myBtn">Rejoignez-nous</button>
</div>    


<div class="row">

    
</div>

<!-- The Modal -->
<div id="myModal" class="modal">

  <!-- Modal content -->
  <!-- <div class="modal-content">-->
    <!--j'ai une balise span qui as pour classe close
    <span class="close">&times;</span>
    <h2>Bienvenue dans notre équipe !</h2>
  </div> -->
  
  <!-- Modal content -->
<div class="modal-content">
    <div class="modal-header">
        <span class="close">&times;</span>
        <h2>Création d'un nouveau membre</h2>
    </div>
    <div class="modal-body"> 
        <p>Souhaitez-vous rejoindre notre équipe ?</p>
        <p>Formulaire de candidature</p>

        <!--formulaire de candidature-->
        <div class="container">
            <form action="/api/equipe" method="post">

                <div class="row">

                    <div class="col-25">
                        <label for="nomMembreEquipe">Nom:</label>
                        <input type="text" id="nomMembreEquipe" name="nomMembreEquipe" placeholder="Votre nom..">
                        
                    </div> 
                    
                    <div class="col-75">
                        <label for="prenomMembreEquipe">Prénom:</label>
                        <input type="text" id="prenomMembreEquipe" name="prenomMembreEquipe" placeholder="Votre prénom..">
                        
                    </div>

                    <div class="col-25">

                        <label for="mailMembreEquipe">Email:</label>
                        <input type="email" id="mailMembreEquipe" name="mailMembreEquipe" placeholder="Votre email..">

                    </div>

                    <div class="col-75">

                        <label for="telephoneMembreEquipe">Téléphone:</label>
                        <input type="text" id="telephoneMembreEquipe" name="telephoneMembreEquipe" placeholder="Votre téléphone..">

                    </div>

                    <div class="col-25">
                        <label for="posteMembreEquipe">Poste:</label>
                        <input type="text" id="posteMembreEquipe" name="posteMembreEquipe" placeholder="Votre poste..">
                    </div>



                    <div class="col-25">
                        <label for="adresseMembreEquipe">Adresse:</label>
                        <input type="text" id="adresseMembreEquipe" name="adresseMembreEquipe" placeholder="Votre adresse..">
                    </div>                 

                    <div class="col-75">
                        <label for="presentationMembreEquipe">Présentation:</label>
                        <textarea id="presentationMembreEquipe" name="presentationMembreEquipe" placeholder="Dites-nous en plus sur vous.." style="height:200px"></textarea>
                    </div>

                    <div class="col-25">
                        <label for="dateRecrutement">Date de recrutement:</label>
                        <input type="date" id="dateRecrutement" name="dateRecrutement">
                    </div>


                </div>

                <div class="row">
                    <button id="btnEnregistrer">Envoyer</button>
                </div>
            </form>   
        </div>

    </div>

  
  
  <div class="modal-footer">
    
    <h3>On cuisine avec MAYGOURMET </h3>
    
  </div>
</div>

</div>
        
   
</body>



</html>