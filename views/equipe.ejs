    <!-- Vue d'accueil -->
    <!-- ici j'ai genéré le code HTML de la page d'accueil--> 

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accueil MayGourmet</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <!-- inclure le fichier navbar.ejs pour avoir la barre de navigation -->
    <%- include('navbar') -%>
    <!-- ici je suis entrein d'appele dans views le fichier navabar.ejs qui est une vue a la navigations  -->

    <h1>Bienvenue dans mon équipe de MayGourmet !</h1>

    <% resultatEquipe.forEach((membre) =>{ %>
        <!--Pour chaque membre de l'équipe je crée une div card -->
        <div id="card">
            <!-- dans cette div tu me fait un enfant-->
            <div class="conter">
                <h4><%= membre.nom %> <%= membre.prenom %> </h4>
            </div>
        </div>
        <%= membre.nom %>

    <% }); %>
        
   
</body>
</html>