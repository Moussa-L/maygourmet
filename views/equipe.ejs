     

<!DOCTYPE html>
    <!-- Vue d'accueil -->
    <!-- ici j'ai genéré le code HTML de la page d'accueil-->
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accueil MayGourmet</title>
    <link rel="stylesheet" href="/css/equipe.css">
    <link rel="stylesheet" href="/css/modale.css">
    
    <!--je vais importer le fichier js -->
    <script src="/js/modale.js" defer>  </script>
    <script src="/js/script.js" defer>  </script>
    

</head>
<body>

    <!-- inclure le fichier navbar.ejs pour avoir la barre de navigation -->
    <%- include('navbar') -%>
    <!-- ici je suis entrein d'appele dans views le fichier navabar.ejs qui est une vue a la navigations  -->

                

    

    <h1>Bienvenue dans mon équipe de MayGourmet !</h1>

  

<%- include('modalEquipe') -%>
 

 <div class="row">
        <% resultatEquipe.forEach((result) =>{ %>
            <div class="container">
                <div class="card">
                    <h2><b><%= result.nom %> <%= result.prenom %><b></h2>
                    <p><%= result.poste %></p>
                    <button type="submit" onclick="supprimerMembre('<%= result.id %>')">Supprimer</button>

                    <!-- <input type="button" value="supprimer" onclick="supprimerMembre('<%= result.id %>')"> -->
                    <img src="/images/Gente blanca 3d.jpg" alt="Chef de projet">

                </div>

                

            </div>
        <% }); %>

    </div>
   
</body>



</html>