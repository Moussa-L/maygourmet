    <!-- Vue d'accueil -->
    <!-- ici j'ai genéré le code HTML de la page d'accueil--> 

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accueil MayGourmet</title>
    <link rel="stylesheet" href="/css/equipe.css">
</head>
<body>

    <!-- inclure le fichier navbar.ejs pour avoir la barre de navigation -->
    <%- include('navbar') -%>
    <!-- ici je suis entrein d'appele dans views le fichier navabar.ejs qui est une vue a la navigations  -->


    

    <h1>Bienvenue dans mon équipe de MayGourmet !</h1>
    

    <% resultatEquipe.forEach((result) =>{ %>
        <!--Pour chaque membre de l'équipe je crée une div card -->
        <div class="row">
            <!-- dans cette div tu me fait un enfant-->
            <div class="container">
                <h4><b><%= result.nom %> <%= result.prenom %><b></h4>
                <p><%= result.poste %></p>
                <input type="button" value="supprimer" onclick="supprimerMembre('<%= result.id %>')">
            </div>
        </div>
        <%= result.nom %>

    <% }); %>
        
   
</body>

<script>
    
</script>

</html>