    <!-- Vue d'accueil -->
    <!-- ici j'ai genéré le code HTML de la page d'accueil--> 

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accueil MayGourmet</title>
    <link rel="stylesheet" href="/css/equipe.css">
    <link rel="stylesheet" href="/css/modale.css">
    
    <!--je vais importer le fichier js -->
    <script src="/js/modale.js" defer>  </script>
    

</head>
<body>

    <!-- inclure le fichier navbar.ejs pour avoir la barre de navigation -->
    <%- include('navbar') -%>
    <!-- ici je suis entrein d'appele dans views le fichier navabar.ejs qui est une vue a la navigations  -->

                

    

    <h1>Bienvenue dans mon équipe de MayGourmet !</h1>

    <div class="container">

    <div class="card">
        <h2>Ngoma Jean</h2>
        <p>Chef de cuisine</p>
        <button>Supprimer</button>
        <img src="/images/orange.png" alt="Chef de cuisine">
    </div>

    <div class="card">
        <h2>Said Fatima</h2>
        <p>Gérante</p>
        <button>Supprimer</button>
        <img src="/images/bleu.png" alt="Gérant">
    </div>

    <div class="card">
        <h2>Doe John</h2>
        <p>Chef de projet</p>
        <button>Supprimer</button>
        <img src="/images/noir.png" alt="Chef de projet">
    </div>

</div>

    

    <% resultatEquipe.forEach((result) =>{ %>
        <!--Pour chaque membre de l'équipe je crée une div card -->
        <div class="row">
            <!-- dans cette div tu me fait un enfant-->
            <div class="container">
                <h4><b><%= result.nom %> <%= result.prenom %><b></h4>
                <p><%= result.poste %></p>
                <input type="button" value="supprimer" onclick="supprimerMembre('<%= result.id %>')">
            </div>

        </div>

    <% }); %>


<div class="row">
    <!-- Trigger/Open The Modal -->
    <button id="myBtn">Rejoignez-nous</button>
</div>    


<div class="row">

    
</div>

<!-- The Modal -->
<div id="myModal" class="modal">

  <!-- Modal content -->
  <!-- <div class="modal-content">-->
    <!--j'ai une balise span qui as pour classe close
    <span class="close">&times;</span>
    <h2>Bienvenue dans notre équipe !</h2>
  </div> -->
  
  <!-- Modal content -->
<div class="modal-content">
    <div class="modal-header">
        <span class="close">&times;</span>
        <h2>Création d'un nouveau membre</h2>
    </div>
    <div class="modal-body"> 
        <p>Souhaitez-vous rejoindre notre équipe ?</p>
        <p>Formulaire de candidature</p>

        <!--formulaire de candidature-->
        <div class="container">
            <form action="/api/equipe" method="post">

                <div class="row">

                    <div class="col-25">
                        <label for="nomMembreEquipe">Nom:</label>
                        <input type="text" id="nomMembreEquipe" name="nomMembreEquipe" placeholder="Votre nom..">
                        
                    </div> 
                    
                    <div class="col-75">
                        <label for="prenomMembreEquipe">Prénom:</label>
                        <input type="text" id="prenomMembreEquipe" name="prenomMembreEquipe" placeholder="Votre prénom..">
                        
                    </div>

                    <div class="col-25">

                        <label for="mailMembreEquipe">Email:</label>
                        <input type="email" id="mailMembreEquipe" name="mailMembreEquipe" placeholder="Votre email..">

                    </div>

                    <div class="col-75">

                        <label for="telephoneMembreEquipe">Téléphone:</label>
                        <input type="text" id="telephoneMembreEquipe" name="telephoneMembreEquipe" placeholder="Votre téléphone..">

                    </div>

                    <div class="col-25">
                        <label for="posteMembreEquipe">Poste:</label>
                        <input type="text" id="posteMembreEquipe" name="posteMembreEquipe" placeholder="Votre poste..">
                    </div>

                    <div class="col-75">
                        <label for="presentationMembreEquipe">Présentation:</label>
                        <textarea id="presentationMembreEquipe" name="presentationMembreEquipe" placeholder="Dites-nous en plus sur vous.." style="height:200px"></textarea>
                    </div>

                    <div class="col-25">
                        <label for="dateRecrutement">Date de recrutement:</label>
                        <input type="date" id="dateRecrutement" name="dateRecrutement">
                    </div>


                </div>
            </form>   
        </div>

    </div>

        


  


  
  <div class="modal-footer">
    
    <h3>On cuisine avec MAYGOURMET </h3>
    <button id="btnEnregistrer">Envoyer</button>
  </div>
</div>

</div>
        
   
</body>

<script>
    function supprimerMembre(id) {
        const routeComplete = '/api/equipe/' + id;
        
        fetch(

            routeComplete,{method: "DELETE"}

        ).then(

            (reponse) => reponse.json()

        ).then(

            (donne) => window.location.href = donnee.routeAccueil

        ).catch(

            (erreur) => console.log(erreur)
        )
        

    }

</script>

</html>